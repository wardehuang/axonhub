#!/usr/bin/env bash
set -euo pipefail

REMOTE_USER="${AXONHUB_REMOTE_USER:-ubuntu}"
REMOTE_HOST="${AXONHUB_REMOTE_HOST:-163.192.9.157}"
REMOTE_SSH_PORT="${AXONHUB_REMOTE_SSH_PORT:-27312}"
SSH_KEY="${AXONHUB_SSH_KEY:-E:/Files/SSH Key/oracle-ssh-key-2026-05-16.key}"
SERVICE_NAME="${AXONHUB_SERVICE_NAME:-axonhub}"
REMOTE="${REMOTE_USER}@${REMOTE_HOST}"
SSH_OPTS=(-i "$SSH_KEY" -p "$REMOTE_SSH_PORT" -o BatchMode=yes -o ConnectTimeout=15)

if [[ ! -f "$SSH_KEY" ]]; then
  printf 'SSH key not found: %s\n' "$SSH_KEY" >&2
  exit 1
fi

ssh "${SSH_OPTS[@]}" "$REMOTE" bash -s -- "$SERVICE_NAME" <<'REMOTE_SCRIPT'
set -euo pipefail
SERVICE_NAME="$1"

sudo -n systemctl stop "$SERVICE_NAME.service"
if sudo -n systemctl is-active --quiet "$SERVICE_NAME.service"; then
  printf 'Service is still active: %s\n' "$SERVICE_NAME" >&2
  exit 1
fi
printf 'STOP_OK service=%s\n' "$SERVICE_NAME"
REMOTE_SCRIPT
